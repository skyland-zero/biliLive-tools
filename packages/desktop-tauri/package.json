{
  "name": "bililive-desktop",
  "version": "3.22.2",
  "description": "biliLive-tools Tauri 桌面端",
  "author": "skyland",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:fast": "tauri build --config '{\"bundle\":{\"windows\":{\"nsis\":{\"compression\":\"zlib\"}}}}'",
    "build:nobundle": "tauri build --no-bundle",
    "tauri": "tauri",
    "bin:ensure": "node scripts/check-bin.js",
    "bin:check": "node scripts/check-bin.js --strict",
    "native:check": "node scripts/ensure-native-abi.js",
    "nsis:prepare": "node scripts/prepare-nsis.js",
    "nsis:sync": "node scripts/sync-nsis-template.js",
    "nsis:check": "node scripts/sync-nsis-template.js --check",
    "vite:dev": "vite",
    "vite:build": "vite build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-os": "^2.4.0",
    "path-unified": "^0.2.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@biliLive-tools/types": "workspace:*",
    "@tauri-apps/cli": "^2.12.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "naive-ui": "^2.44.1",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.1.10",
    "vue": "^3.5.13"
  }
}
